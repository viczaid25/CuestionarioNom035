@using CuestionarioNom035.Auth
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Autorizacion
@inject IConfiguration Config
@inject IWebHostEnvironment Env
@{
    var title = ViewData["Title"] ?? "Cuestionario NOM-35";
    var conSesion = User?.Identity?.IsAuthenticated == true;
    var verReportes = conSesion && (await Autorizacion.AuthorizeAsync(User!, Permisos.Reportes)).Succeeded;
    var verMedico = conSesion && (await Autorizacion.AuthorizeAsync(User!, Permisos.ServicioMedico)).Succeeded;
    var modoDev = DevAuth.Habilitado(Env, Config);
    // Latido solo con sesión del SSO; el login de desarrollo no tiene hub.
    string? heartbeatUrl = conSesion && User!.Identity!.AuthenticationType != DevAuth.SchemeName
        ? $"{HubSso.HubBaseUrl(Config)}/auth/heartbeat?system={Uri.EscapeDataString(HubSso.SystemCode(Config))}"
        : null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - NOM35</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Fuente moderna -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Estilos personalizados -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-semibold" href="~/">NOM-35</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                    <!-- Cuestionario -->
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Cuestionario" asp-action="Inicio">Cuestionario</a>
                    </li>

                    <!-- Diagnóstico ATS -->
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Ats" asp-action="Index">Diagnóstico ATS</a>
                    </li>

                    <!-- Reportes -->
                    @if (verReportes)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="repDrop" role="button" data-bs-toggle="dropdown"
                               aria-expanded="false">Reportes</a>
                            <ul class="dropdown-menu" aria-labelledby="repDrop">
                                <li>
                                    <a class="dropdown-item" asp-controller="Reportes" asp-action="Validacion">Validación de carga</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Reportes" asp-action="SeguimientoAts">Seguimiento ATS</a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Reportes" asp-action="Dashboard">Dashboard</a>
                        </li>
                    }

                    @if (verMedico)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="ServicioMedico" asp-action="Index">Servicio Médico</a>
                        </li>
                    }


                </ul>

                <!-- Usuario -->
                @if (conSesion)
                {
                    var nombre = UsuarioActual.Nombre(User!);
                    <div class="dropdown">
                        <a class="nav-link dropdown-toggle text-white" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="badge rounded-circle bg-light text-primary me-1">@UsuarioActual.Iniciales(nombre)</span> @nombre
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><span class="dropdown-item-text small text-muted">Nómina @UsuarioActual.Nomina(User!) · @User!.FindFirst(MeaxClaims.Department)?.Value</span></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" href="@($"{HubSso.HubBaseUrl(Config)}/")">Volver a MEAX One</a></li>
                            @if (!modoDev)
                            {
                                <li><a class="dropdown-item" href="~/salir">Cerrar sesión</a></li>
                            }
                        </ul>
                    </div>
                }
                else
                {
                    <a class="nav-link text-white" asp-controller="Home" asp-action="Entrar">Iniciar sesión</a>
                }
            </div>
        </div>
    </nav>


    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="footer mt-auto py-3 border-top text-center text-muted">
        <small>&copy; @(DateTime.Now.Year) NOM-35 Cuestionario</small>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @if (heartbeatUrl is not null)
    {
        <script>window.meaxHeartbeatUrl = '@heartbeatUrl';</script>
    }
    <script src="~/js/meax-heartbeat.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
